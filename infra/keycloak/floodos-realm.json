{
  "id": "floodos",
  "realm": "floodos",
  "displayName": "FloodOS",
  "displayNameHtml": "FloodOS",
  "loginTheme": "floodos",
  "internationalizationEnabled": true,
  "supportedLocales": [
    "vi"
  ],
  "defaultLocale": "vi",
  "enabled": true,
  "sslRequired": "none",
  "registrationAllowed": false,
  "loginWithEmailAllowed": true,
  "duplicateEmailsAllowed": false,
  "resetPasswordAllowed": true,
  "editUsernameAllowed": false,
  "roles": {
    "realm": [
      {
        "name": "REPORTER",
        "description": "Người báo tin: gửi tin báo ngập và theo dõi tin báo của chính mình"
      },
      {
        "name": "DISPATCHER",
        "description": "Điều phối viên: xác minh tin báo, xếp ưu tiên, điều đội và phương tiện, duyệt điều phối lại"
      },
      {
        "name": "FIELD_TEAM",
        "description": "Đội hiện trường: nhận lệnh, cập nhật tiến độ và báo sự cố phương tiện"
      },
      {
        "name": "RESOURCE_MANAGER",
        "description": "Quản lý nguồn lực: theo dõi phương tiện, đội và phiếu sửa chữa; không duyệt điều động"
      },
      {
        "name": "PLATFORM_ADMIN",
        "description": "Quản trị kỹ thuật nền tảng FloodOS"
      }
    ]
  },
  "clients": [
    {
      "clientId": "floodos-web",
      "name": "FloodOS Web (public client, PKCE S256)",
      "enabled": true,
      "publicClient": true,
      "standardFlowEnabled": true,
      "directAccessGrantsEnabled": false,
      "redirectUris": [
        "http://localhost:9080/*",
        "http://127.0.0.1:9080/*",
        "http://localhost:3000/*",
        "http://127.0.0.1:3000/*",
        "http://localhost:5173/*",
        "http://127.0.0.1:5173/*"
      ],
      "webOrigins": [
        "http://localhost:9080",
        "http://127.0.0.1:9080",
        "http://localhost:3000",
        "http://127.0.0.1:3000",
        "http://localhost:5173",
        "http://127.0.0.1:5173"
      ],
      "attributes": {
        "pkce.code.challenge.method": "S256",
        "post.logout.redirect.uris": "+"
      },
      "protocolMappers": [
        {
          "name": "organization_id_mapper",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-usermodel-attribute-mapper",
          "consentRequired": false,
          "config": {
            "userinfo.token.claim": "true",
            "user.attribute": "organization_id",
            "id.token.claim": "true",
            "access.token.claim": "true",
            "claim.name": "organization_id",
            "jsonType.label": "String"
          }
        },
        {
          "name": "floodos_web_audience_mapper",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-audience-mapper",
          "consentRequired": false,
          "config": {
            "included.client.audience": "floodos-web",
            "id.token.claim": "true",
            "access.token.claim": "true"
          }
        }
      ]
    },
    {
      "clientId": "floodos-gateway",
      "name": "Apache APISIX Zero-Trust Gateway Confidential Client",
      "enabled": true,
      "publicClient": false,
      "secret": "${KEYCLOAK_INTROSPECTION_CLIENT_SECRET:-floodos-gateway-secret-2026}",
      "serviceAccountsEnabled": true,
      "standardFlowEnabled": false,
      "directAccessGrantsEnabled": false,
      "protocol": "openid-connect"
    }
  ],
