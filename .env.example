# ============================================================================
# FLOODOS ENVIRONMENT CONFIGURATION EXAMPLE (.env.example)
# Sao chép tệp này thành .env trước khi chạy: cp .env.example .env
# Lưu ý: Tuyệt đối không commit mật khẩu thật lên kho mã nguồn!
# ============================================================================

# 1. Identity & Auth Mode
# Giá trị: KEYCLOAK_PRODUCTION (yêu cầu Keycloak live) hoặc DEV_MOCK_STANDALONE (demo/CI)
FLOODOS_AUTH_MODE=KEYCLOAK_PRODUCTION
KEYCLOAK_ISSUER=http://keycloak:8080/realms/floodos
KEYCLOAK_ADMIN=admin
KEYCLOAK_ADMIN_PASSWORD=admin_dev_only
KEYCLOAK_REALM=floodos

# 2. Structured Data (PostgreSQL 16)
POSTGRES_USER=floodos
POSTGRES_PASSWORD=floodos_dev_only
POSTGRES_DB=floodos_db
POSTGRES_APP_USER=floodos_app
POSTGRES_APP_PASSWORD=floodos_app_dev_only
DATABASE_URL=jdbc:postgresql://postgres:5432/floodos_db

# 3. Object Storage (SeaweedFS S3 - Apache-2.0)
S3_ENDPOINT=http://object-storage:9000
S3_BUCKET=floodos-evidence

# 4. Workflow Engine (Flowable BPMN 2.0 REST - Apache-2.0)
FLOWABLE_REST_URL=http://flowable:8081/flowable-rest
FLOWABLE_ENDPOINT=http://flowable:8081/flowable-rest

# 5. Gateway Confidential Client Credentials (RFC 7662)
# CẢNH BÁO AN NINH: Secret dưới đây CHỈ DÙNG CHO PHÁT TRIỂN / DEMO CỤC BỘ.
# Khi triển khai thực tế (Production), bắt buộc phải đổi sang chuỗi ngẫu nhiên mạnh hoặc inject qua Secret Store!
KEYCLOAK_INTROSPECTION_CLIENT_ID=floodos-gateway
KEYCLOAK_INTROSPECTION_CLIENT_SECRET=floodos-gateway-secret-2026

# 6. Core Ports
CORE_API_PORT=8000
APISIX_GATEWAY_PORT=9080

# 5. OT Telemetry (MQTT - Eclipse Mosquitto, EPL-2.0)
# Production (compose.prod.yaml) REQUIRES all three secrets; dev defaults are for local use only.
MQTT_DEVICE_USER=device
MQTT_DEVICE_PASSWORD=device_dev_only
MQTT_INGESTOR_USER=ingestor
MQTT_INGESTOR_PASSWORD=ingestor_dev_only
# Shared secret between telemetry-ingestor and core-api for /api/v1/internal/*
FLOODOS_INGEST_TOKEN=ingest_dev_only_token
# Host port for the broker (dev only, bound to 127.0.0.1)
MQTT_HOST_PORT=18830
