# Ensure bash scripts and SQL files always have LF line endings
*.sh text eol=lf
*.sql text eol=lf
*.json text eol=lf
*.conf text eol=lf
*.py text eol=lf
Dockerfile text eol=lf
*.yaml text eol=lf
*.yml text eol=lf
*.svg text eol=lf

# Protect binary images from line-ending conversion
*.png binary
*.jpg binary
*.jpeg binary
*.ico binary
*.webp binary
*.gif binary
*.jar binary
